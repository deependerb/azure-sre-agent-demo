# =====================================================================
# Azure SRE Agent Demo - environment configuration
# Copy this file to ".env" and edit the values. NEVER commit ".env".
#   cp .env.example .env
# =====================================================================

# --- Core Azure context ---
# NOTE: small VM sizes are capacity-restricted in some regions/subscriptions.
# If deployment fails with 'SkuNotAvailable', pick another region/size. Find
# available sizes with:
#   az vm list-skus -l <region> --resource-type virtualMachines --all false \
#     --query "[?starts_with(name,'Standard_D2') || starts_with(name,'Standard_B2')].name" -o tsv
export SUBSCRIPTION_ID="<your-subscription-id>"
export LOCATION="eastus2"
export RESOURCE_GROUP="rg-sre-agent-demo"
export PREFIX="sredemo"                 # short lowercase prefix for resource names

# --- Target Windows VM ---
export VM_NAME="${PREFIX}-win-vm"
export VM_SIZE="Standard_D2s_v3"        # verified available in eastus2; change if restricted
export VM_IMAGE="MicrosoftWindowsServer:WindowsServer:2022-datacenter-azure-edition:latest"
export VM_ADMIN_USERNAME="azureadmin"
# Do NOT put the password here. Export it in your shell right before deploying:
#   read -s -p "VM admin password: " VM_ADMIN_PASSWORD && export VM_ADMIN_PASSWORD
# The password must meet Azure complexity rules (12-123 chars, 3 of 4 categories).

# --- Monitoring / Log Analytics ---
export LAW_NAME="${PREFIX}-law"
export DCR_NAME="${PREFIX}-dcr-guest"

# --- Alert thresholds (tune for the demo) ---
export CPU_THRESHOLD="95"               # percent
export CPU_WINDOW_MIN="15"              # minutes the condition must hold
export MEM_USED_THRESHOLD="95"          # percent committed bytes in use

# --- SRE Agent ---
# Filled in AFTER you create the SRE Agent in the portal (Builder creates a
# managed identity). Get its principal (object) id from the portal or:
#   az resource show --ids <agent-resource-id> --query identity.principalId -o tsv
export SRE_AGENT_MI_PRINCIPAL_ID="<sre-agent-managed-identity-object-id>"
# Scope the agent can act on. Start narrow (resource group), never subscription in prod.
export SRE_AGENT_RBAC_SCOPE="/subscriptions/${SUBSCRIPTION_ID}/resourceGroups/${RESOURCE_GROUP}"
